DATABASE_URL="postgresql://applyflow:applyflow@localhost:5432/applyflow?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Enable Google Calendar API for the OAuth client.
# The app requests https://www.googleapis.com/auth/calendar.readonly at login.
# Enable Gmail API for the OAuth client.
# The app requests https://www.googleapis.com/auth/gmail.readonly at login.

# OpenAI email extraction
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional future integrations
SENTRY_DSN=""
POSTHOG_KEY=""
