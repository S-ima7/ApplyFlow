DATABASE_URL="<Neon pooled URL>"
# Use Neon's direct URL for migrations.
DIRECT_URL="<Neon direct URL>"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
AUTH_URL="https://<site>.netlify.app"
NEXTAUTH_URL="https://<site>.netlify.app"

# Enable Google Calendar API for the OAuth client.
# The app requests https://www.googleapis.com/auth/calendar.readonly at login.
# Enable Gmail API for the OAuth client.
# The app requests https://www.googleapis.com/auth/gmail.readonly at login.

# Zero-additional-cost AI extraction on Cloudflare Workers AI Free.
# Keep the account on Workers Free; ApplyFlow never falls back to paid AI APIs.
AI_PROVIDER="cloudflare-workers-ai"
AI_MODEL="@cf/openai/gpt-oss-120b"
AI_REASONING_EFFORT="high"
AI_DAILY_NEURON_BUDGET="10000"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Internal signature shared by the Netlify scheduler and background worker.
# Generate at least 32 random bytes and keep this server-side.
EMAIL_MONITOR_WORKER_SECRET=""

# Optional future integrations
SENTRY_DSN=""
POSTHOG_KEY=""
